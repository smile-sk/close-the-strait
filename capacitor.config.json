{
  "appId": "com.creadevapps.straitcontrol",
  "appName": "Strait Control",
  "webDir": "client",
  "backgroundColor": "#070707",
  "android": {
    "backgroundColor": "#070707"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#070707",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true,
      "useDialog": false
    }
  }
}
